@startuml c4-context-system
' C4 Level 1 — System Context. Who uses jairojobs and what it talks to.
' Source of truth: docs/specs/000-product-overview/spec.md
!include <C4/C4_Context>

LAYOUT_WITH_LEGEND()

title jairojobs — System Context

Person(visitor, "Visitor", "Browses and searches listings without an account. Mobile-first.")
Person(candidate, "Candidate", "Job seeker in the Philippines. Owns a profile + CV, applies to listings.")
Person(employer, "Employer", "Local business hiring in a PH region. Posts listings, receives applications.")
Person(admin, "Admin", "Approves, rejects, edits and takes down listings; manages regions; may post listings. Operator-appointed.")

System(jairojobs, "jairojobs", "National job board for the Philippines, organized by region. Phoenix / LiveView web app.")

System_Ext(email, "Resend", "Delivers magic links, confirmations, moderation emails and application emails from hello@jairojobs.com (ADR-0005).")
System_Ext(inbox, "User inbox", "Where magic links, moderation emails and application emails arrive.")
System_Ext(search, "Search engine", "Reads the public pages and the sitemap, so listings can be found (spec 005).")
System_Ext(chat, "Chat app", "Reads a shared listing's page to show a text preview of the link (spec 005).")

Rel(visitor, jairojobs, "Browses, searches, opens and shares listings (005), signs up", "HTTPS")
Rel(candidate, jairojobs, "Logs in, manages profile, applies", "HTTPS")
Rel(employer, jairojobs, "Logs in, posts listings", "HTTPS")
Rel(admin, jairojobs, "Moderates and posts listings, manages regions", "HTTPS")

Rel(search, jairojobs, "Reads public pages, job details and /sitemap.xml", "HTTPS")
Rel(chat, jairojobs, "Reads a listing's page for its preview", "HTTPS")
Rel(visitor, search, "Finds listings through")
Rel(visitor, chat, "Shares and receives links in")

Rel(jairojobs, email, "Sends email via", "SMTP / API")
Rel(email, inbox, "Delivers to")
Rel(inbox, jairojobs, "Magic-link click", "HTTPS")
Rel(candidate, inbox, "Reads sign-in links")
Rel(employer, inbox, "Reads sign-in links, decisions on their listings (004), applications (phase 1)")
Rel(admin, inbox, "Reads sign-in links, listings waiting for approval (004)")

@enduml
