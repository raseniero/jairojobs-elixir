@startuml use-cases
' Product-level use case diagram — who can do what.
' Source of truth: docs/specs/000-product-overview/spec.md (personas + access matrix + feature map)
' Render: scripts/render-diagrams.sh

left to right direction
skinparam actorStyle awesome
hide stereotype
skinparam usecase {
  BackgroundColor<<phase2>> #E8E8E8
  BackgroundColor<<phase3>> #CFCFCF
  BorderColor<<phase2>> #999999
  BorderColor<<phase3>> #999999
}

actor Visitor
actor Candidate
actor Employer
actor Admin
actor Operator

rectangle "jairojobs" {
  usecase "Browse & search listings" as UC1
  usecase "Sign up / Log in" as UC2
  usecase "Create profile\nfrom CV" as UC3
  usecase "Apply to listing" as UC4
  usecase "Post listing" as UC5
  usecase "Receive applications\nby email" as UC6
  usecase "Approve / reject /\ntake down listing" as UC7
  usecase "Manage regions" as UC8
  usecase "Promote / demote\nadmin" as UC9
  usecase "Manage applications\non-platform" as UC10 <<phase2>>
  usecase "Subscribe (paid)" as UC11 <<phase3>>
  usecase "Post / apply to\nfreelance gigs" as UC12 <<phase3>>
}

Visitor --> UC1
Visitor --> UC2

Candidate --> UC1
Candidate --> UC3
Candidate --> UC4
Candidate --> UC12

Employer --> UC1
Employer --> UC5
Employer --> UC6
Employer --> UC10
Employer --> UC11
Employer --> UC12

Admin --> UC7
Admin --> UC8

Operator --> UC9

UC4 ..> UC2 : <<include>>
UC5 ..> UC2 : <<include>>
UC5 ..> UC7 : <<include>>\nadmin approval

legend right
  **Shading = phase**
  white — phase 1 (launch)
  light grey — phase 2
  dark grey — phase 3
endlegend

@enduml
