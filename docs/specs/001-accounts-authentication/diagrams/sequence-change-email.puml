@startuml sequence-change-email
' Spec 001 — change email with confirmation of the new address (REQ-001-6).
' Parties: Browser, JairojobsWeb (Settings LiveView), Jairojobs.Accounts, Postgres, Mailer, new inbox.

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor User
participant "Browser" as B
participant "JairojobsWeb\n(Settings LiveView)" as W
participant "Jairojobs.Accounts" as ACC
database "Postgres" as DB
participant "Jairojobs.Mailer\n(Swoosh)" as M
participant "New address inbox" as NEW

== Request change ==
User -> B : open /users/settings
B -> W : mount (requires login;\nsudo mode re-auth if session is old)
W --> B : settings form\n(role shown read-only)
User -> B : enter new email, submit
B -> W : submit
W -> ACC : change_user_email(scope, new_email)
ACC -> ACC : validate format
ACC -> DB : check uniqueness
alt new email available
  ACC -> ACC : build "change:<old>" token\n(hashed, carries new email, expires 1 day)
  ACC -> DB : insert user_token
  ACC -> M : deliver_update_email_instructions(user, new_email, url)
  M -> NEW : email with confirm link
  ACC --> W : :ok
  W --> B : "A link to confirm your email change\nhas been sent to the new address"
  note right of DB : users.email is NOT changed yet
else already used by another account
  ACC --> W : {:error, changeset}
  W --> B : validation error
end

== Confirm new address ==
User -> NEW : open email
NEW -> B : click /users/settings/confirm-email/:token
B -> W : GET with token
W -> ACC : update_user_email(user, token)
ACC -> DB : lookup token (hash + "change:<old>" context),\ncheck expiry
alt valid
  ACC -> DB : update users.email = new_email
  ACC -> DB : delete tokens for "change:<old>" context
  ACC --> W : :ok
  W --> B : "Email changed successfully"
else expired / used / unknown
  ACC --> W : :error
  W --> B : "Email change link is invalid or it has expired"
end

note over B, NEW
  Magic-link and password logins continue to use the OLD email until confirmation.
  Session tokens are not revoked by an email change.
end note

@enduml
