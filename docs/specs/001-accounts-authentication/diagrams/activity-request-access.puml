@startuml activity-request-access
' Spec 001 — every request: mount scope, decide access, render role-aware nav (REQ-001-1, -9, -12)
' Updated 2026-11-12: non-admins are sent home (spec 002, was 403); posting area added (spec 003).
title Request access and role-aware navigation (REQ-001-1, REQ-001-9, REQ-001-12)

start
:HTTP / LiveView request arrives;
:Read session cookie;
if (Valid session token?) then (yes)
  :Load user;
  :scope = %Scope{user: user}
  (role available: candidate / employer / admin);
else (no)
  :scope = nil (Visitor);
endif
if (Route requires login?) then (yes)
  if (scope present?) then (no)
    :Store requested path;
    :Redirect to log-in;
    note right
      After login, return to
      the requested path.
    end note
    stop
  else (yes)
  endif
  if (Route requires admin?) then (yes)
    if (scope.user.role == admin?) then (no)
      :Send home with a
      "not authorized" message;
      stop
    else (yes)
    endif
  else (no)
  endif
  if (Route is in the posting area?\n(Employer or Admin — spec 003)) then (yes)
    if (role is employer or admin?) then (no)
      :Send home with a
      "not authorized" message;
      stop
    else (yes)
    endif
  else (no)
  endif
else (no)
  note right
    Public pages: home, listing index,
    listing detail, sign-up, log-in.
    Never redirect a Visitor here.
  end note
endif
:Render page with layout;
switch (scope role)
case (none / Visitor)
  :Nav: Browse jobs · Sign up · Log in;
case (candidate)
  :Nav: Browse jobs · My applications ·
  My profile · Settings · Log out;
case (employer)
  :Nav: Browse jobs · My listings ·
  Post a job · Settings · Log out;
case (admin)
  :Nav: Browse jobs · Admin ·
  Settings · Log out;
endswitch
stop
@enduml
