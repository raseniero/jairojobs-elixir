@startuml activity-settings
' Spec 001 — account settings and log out (REQ-001-6, REQ-001-7, REQ-001-8)
title Settings: change email, change password, log out (REQ-001-6/7/8)

start
:Open Settings
(must be logged in);
if (Authenticated within
last 10 min (sudo)?) then (no)
  :Require re-authentication
  (sudo mode);
  :Re-authenticate;
else (yes)
endif
:Show settings
(role as read-only label);
switch (Action)
case (Change email)
  :Enter new email;
  if (Format valid AND
  not used by another account?) then (no)
    :Show validation error;
    stop
  else (yes)
  endif
  :Create change-email token
  (carries new email, expires 7 days);
  :Send confirmation link
  to NEW address;
  :Current email unchanged;
  :Click link in new inbox;
  if (Token valid?) then (no)
    :Show "link invalid or expired";
    stop
  else (yes)
  endif
  :Update email;
  :Delete change-email tokens;
  :Email changed;
  stop
case (Change / set password)
  :Enter new password + confirmation
  (no current password is asked);
  if (New password 12–72 chars?) then (no)
    :Show validation error;
    stop
  else (yes)
  endif
  :Update hashed password;
  :Log out other sessions;
  :Password updated;
  stop
case (Log out)
  :Delete session token;
  :Clear session cookie;
  :Logged out —
  protected pages redirect to log in;
  stop
endswitch
@enduml
